<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>AlgoVision Pro</display-name>
    <description>Interactive DSA Learning, Algorithm Visualization and Performance Analysis Platform</description>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session Timeout Configuration (30 minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- Authentication Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.algovision.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.algovision.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.algovision.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Dashboard Servlet -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.algovision.controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Algorithm Servlets -->
    <servlet>
        <servlet-name>AlgorithmServlet</servlet-name>
        <servlet-class>com.algovision.controller.AlgorithmServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AlgorithmServlet</servlet-name>
        <url-pattern>/algorithms</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VisualizationServlet</servlet-name>
        <servlet-class>com.algovision.controller.VisualizationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VisualizationServlet</servlet-name>
        <url-pattern>/visualize</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DataStructureServlet</servlet-name>
        <servlet-class>com.algovision.controller.DataStructureServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DataStructureServlet</servlet-name>
        <url-pattern>/datastructures</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PerformanceServlet</servlet-name>
        <servlet-class>com.algovision.controller.PerformanceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PerformanceServlet</servlet-name>
        <url-pattern>/performance</url-pattern>
    </servlet-mapping>

    <!-- Interactive Modules -->
    <servlet>
        <servlet-name>QuizServlet</servlet-name>
        <servlet-class>com.algovision.controller.QuizServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>QuizServlet</servlet-name>
        <url-pattern>/quiz</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ChallengeServlet</servlet-name>
        <servlet-class>com.algovision.controller.ChallengeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChallengeServlet</servlet-name>
        <url-pattern>/challenges</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RecommendationServlet</servlet-name>
        <servlet-class>com.algovision.controller.RecommendationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecommendationServlet</servlet-name>
        <url-pattern>/recommendation</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProgressServlet</servlet-name>
        <servlet-class>com.algovision.controller.ProgressServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProgressServlet</servlet-name>
        <url-pattern>/progress</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>com.algovision.controller.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/report</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.algovision.controller.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
    </servlet-mapping>

</web-app>
